# Salin ke .env lalu isi. Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DATABASE_URL=sqlite:///./parkirboss.db

# Minimum confidence accepted from the SmartPark ANPR bridge. Calibrate this
# against the deployed camera; 0.40 is the validated local-demo value.
MIN_ANPR_CONFIDENCE=0.40

# Per-device secrets disimpan di tabel 'devices' (bukan di .env).
# Gunakan seed.py untuk menambah device baru, atau API admin.
# Default seed devices: lihat core/seed.py

# Opsional: path ke model YOLO (jika tidak di lokasi default)
# YOLO_MODEL_PATH=/path/to/best.pt
